# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ZendBX Configuration
ZENDBX_API_URL=https://api.zendbx.in
ZENDBX_ANON_KEY=your_zendbx_anon_key_here
ZENDBX_SERVICE_KEY=your_zendbx_service_role_key_here
ZENDBX_PROJECT_SLUG=your-project-slug

# Hugging Face Configuration
HF_TOKEN=your_huggingface_token_here

# Server Configurationn env e
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Public backend URL — required for Instagram scheduled posts (Meta must fetch image URLs)
# Use your deployed API URL or an ngrok tunnel when developing locally
# PUBLIC_API_BASE_URL=https://your-public-domain.com

# Post Scheduler Configuration
# Enable/disable automatic post scheduling (true/false)
# When enabled, the scheduler checks every 60 seconds for posts to publish
AUTO_POST_SCHEDULER_ENABLED=false
# Scheduler check interval in seconds (default: 60)
SCHEDULER_CHECK_INTERVAL=60
